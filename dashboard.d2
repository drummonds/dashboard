direction: right

title: "hum3 / drummonds — Repository Dashboard" {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

gobank: "GoBank Ecosystem" {
  style.fill: "#dbeafe"
  style.stroke: "#3b82f6"
  grid-columns: 2

  gb: gobank {
    link: https://codeberg.org/hum3/gobank
    tooltip: "Banking platform"
  }
  gl: go-luca {
    link: https://codeberg.org/hum3/go-luca
    tooltip: "Core ledger component inspired by Luca Pacioli"
  }
  ptaf: "plain-text-\naccounting-formats" {
    link: https://codeberg.org/hum3/plain-text-accounting-formats
    tooltip: "PTA tree-sitter grammar in Go"
  }
  p2s: pta2svg {
    link: https://codeberg.org/hum3/pta2svg
    tooltip: "PTA text to SVG conversion"
  }
  mfps: mock-fps {
    link: https://codeberg.org/hum3/mock-fps
    tooltip: "Mock FPS for testing"
  }
}

parsing: "Tree-sitter & Parsing" {
  style.fill: "#ffedd5"
  style.stroke: "#f97316"
  grid-columns: 2

  gts: gotreesitter {
    link: https://codeberg.org/hum3/gotreesitter
    tooltip: "Pure Go tree-sitter runtime"
  }
  tsb: go-tsbin {
    link: https://codeberg.org/hum3/go-tsbin
    tooltip: "ABNF grammar to ts bin blobs"
  }
  tsp: tree-sitter-pta {
    link: https://codeberg.org/hum3/tree-sitter-pta
    tooltip: "Tree-sitter grammar for PTA files"
  }
  tsgl: tree-sitter-goluca {
    link: https://codeberg.org/hum3/tree-sitter-goluca
    tooltip: "Tree-sitter grammar for Go-Luca files"
  }
  ts2a: tree-sitter2abnf {
    link: https://codeberg.org/hum3/tree-sitter2abnf
    tooltip: "Tree-sitter to ABNF conversion and back"
  }
}

godocs: "Godocs Ecosystem" {
  style.fill: "#dcfce7"
  style.stroke: "#22c55e"
  grid-columns: 2

  gd: godocs {
    link: https://codeberg.org/hum3/godocs
    tooltip: "Document management system for home users"
  }
  gdc: godocs-client {
    link: https://codeberg.org/hum3/godocs-client
    tooltip: "Go client for godocs"
  }
  gdh: godocs-hash {
    link: https://codeberg.org/hum3/godocs-hash
    tooltip: "Hash library and tooling for godocs"
  }
  gdi: godocs-importer {
    link: https://codeberg.org/hum3/godocs-importer
    tooltip: "Import from Evernote and other repositories"
  }
  gdin: godocs-inbox {
    link: https://codeberg.org/hum3/godocs-inbox
    tooltip: "Local LLM classifier for godocs inbox"
  }
  gdw: godocs-watcher {
    link: https://codeberg.org/hum3/godocs-watcher
    tooltip: "Directory watcher for automatic imports"
  }
}

webui: "Web & UI" {
  style.fill: "#f3e8ff"
  style.stroke: "#a855f7"
  grid-columns: 2

  lg: lofigui {
    link: https://codeberg.org/hum3/lofigui
    tooltip: "HTML/CSS-first simple web front ends"
  }
  bb: bytestoneblog {
    link: https://codeberg.org/hum3/bytestoneblog
    tooltip: "Blog on Kubernetes"
  }
  u2s: url2svg {
    link: https://codeberg.org/hum3/url2svg
    tooltip: "URL to SVG representation"
  }
  hgl: hugo-golunr {
    link: https://codeberg.org/hum3/hugo-golunr
    tooltip: "Hugo lunr alternative in Go"
  }
  mgr: mermaid-go-renderer {
    link: https://codeberg.org/hum3/mermaid-go-renderer
    tooltip: "Fast native Go Mermaid diagram renderer"
  }
}

hardware: "Hardware & Media" {
  style.fill: "#fce7f3"
  style.stroke: "#ec4899"
  grid-columns: 2

  gp: gophoto {
    link: https://codeberg.org/hum3/gophoto
    tooltip: "GoKrazy picture frame"
  }
  gth: go-thumbnails {
    link: https://codeberg.org/hum3/go-thumbnails
    tooltip: "Document thumbnail generator"
  }
  ptg: ptouch-goprint {
    link: https://codeberg.org/hum3/ptouch-goprint
    tooltip: "Go port for Ptouch E550W printer"
  }
  g3d: go3dp {
    link: https://codeberg.org/hum3/go3dp
    tooltip: "3D printing"
  }
}

datadb: "Data & Databases" {
  style.fill: "#fef9c3"
  style.stroke: "#eab308"
  grid-columns: 2

  tdb: tartan-database {
    link: https://codeberg.org/hum3/tartan-database
    tooltip: "Tartan database"
  }
  td: tartan_data {
    link: https://codeberg.org/hum3/tartan_data
    tooltip: "Tartan data"
  }
  gpg: go-postgres {
    link: https://codeberg.org/hum3/go-postgres
    tooltip: "Pure Go Postgres with local file storage"
  }
  cs: carol_sheet {
    link: https://codeberg.org/hum3/carol_sheet
    tooltip: "Carol sheets with accordion notation"
  }
}

tooling: Tooling {
  style.fill: "#f1f5f9"
  style.stroke: "#64748b"

  tp: task-plus {
    link: https://codeberg.org/hum3/task-plus
    tooltip: "Release helper for taskfile.dev"
  }
  c4: c4test {
    link: https://codeberg.org/hum3/c4test
    tooltip: "C4 architecture testing"
  }
  db: dashboard {
    link: https://codeberg.org/hum3/dashboard
    tooltip: "This repository dashboard"
  }
}

libs: Libraries {
  style.fill: "#e0f2fe"
  style.stroke: "#0ea5e9"

  glb: go_labels {
    link: https://codeberg.org/hum3/go_labels
    tooltip: "Labels library"
  }
  gm: gomail {
    link: https://codeberg.org/hum3/gomail
    tooltip: "Mail library"
  }
}

github_only: "GitHub Only" {
  style.fill: "#fee2e2"
  style.stroke: "#ef4444"
  grid-columns: 2

  ch: charts {
    link: https://github.com/drummonds/charts
    tooltip: "Go charting and graphing library"
  }
  cga: confluence-go-api {
    link: https://github.com/drummonds/confluence-go-api
    tooltip: "Confluence REST API in Go"
  }
  dgt: doltgres-tasks {
    link: https://github.com/drummonds/doltgres-tasks
    tooltip: "Doltgres tasks"
  }
  gpl: gopglite {
    link: https://github.com/drummonds/gopglite
    tooltip: "File-based PGLite proof of concept"
  }
  kgt: kgt {
    link: https://github.com/drummonds/kgt
    tooltip: "BNF wrangling and railroad diagrams"
  }
  owc: openwrt-configurator {
    link: https://github.com/drummonds/openwrt-configurator
    tooltip: "OpenWrt UCI configuration CLI"
  }
  plt: pglike_todo {
    link: https://github.com/drummonds/pglike_todo
    tooltip: "Todo app testing go-pglike"
  }
}

# Relationships between ecosystems
gobank -> parsing: "uses" {style.stroke-dash: 3}
godocs -> hardware: "uses thumbnails" {style.stroke-dash: 3}
gobank -> datadb: "uses postgres" {style.stroke-dash: 3}
