direction: right

title: "hum3 / drummonds — Repository Dashboard" {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

gobank: "GoBank Ecosystem" {
  style.fill: "#dbeafe"
  style.stroke: "#3b82f6"
  grid-columns: 2

  gb: "gobank ⚠️" {
    link: https://h3-gobank.statichost.page/
    tooltip: "Banking platform"
  }
  gl: "go-luca ⚠️" {
    link: https://h3-go-luca.statichost.page/
    tooltip: "Core ledger component inspired by Luca Pacioli"
  }
  ptaf: "plain-text-\naccounting-formats" {
    link: https://h3-pta-formats.statichost.page/
    tooltip: "PTA tree-sitter grammar in Go"
  }
  p2s: "pta2svg ⚠️" {
    link: https://h3-pta2svg.statichost.page/
    tooltip: "PTA text to SVG conversion"
  }
  mfps: "mock-fps ⚠️" {
    link: https://h3-mock-fps.statichost.page/
    tooltip: "Mock FPS for testing"
  }
}

parsing: "Tree-sitter & Parsing" {
  style.fill: "#ffedd5"
  style.stroke: "#f97316"
  grid-columns: 2

  gts: "gotreesitter ⚠️" {
    link: https://h3-gotreesitter.statichost.page/
    tooltip: "Pure Go tree-sitter runtime"
  }
  tsb: go-tsbin {
    link: https://codeberg.org/hum3/go-tsbin
    tooltip: "ABNF grammar to ts bin blobs"
  }
  tsp: tree-sitter-pta {
    link: https://h3-tree-sitter-pta.statichost.page/
    tooltip: "Tree-sitter grammar for PTA files"
  }
  tsgl: tree-sitter-goluca {
    link: https://h3-tree-sitter-goluca.statichost.page/
    tooltip: "Tree-sitter grammar for Go-Luca files"
  }
  ts2a: "tree-sitter2abnf ⚠️" {
    link: https://h3-tree-sitter2abnf.statichost.page/
    tooltip: "Tree-sitter to ABNF conversion and back"
  }
}

godocs: "Godocs Ecosystem" {
  style.fill: "#dcfce7"
  style.stroke: "#22c55e"
  grid-columns: 2

  gd: "godocs ⚠️" {
    link: https://h3-godocs.statichost.page/
    tooltip: "Document management system for home users"
  }
  gdc: "godocs-client ⚠️" {
    link: https://h3-godocs-client.statichost.page/
    tooltip: "Go client for godocs"
  }
  gdh: "godocs-hash ⚠️" {
    link: https://h3-godocs-hash.statichost.page/
    tooltip: "Hash library and tooling for godocs"
  }
  gdi: "godocs-importer ⚠️" {
    link: https://h3-godocs-importer.statichost.page/
    tooltip: "Import from Evernote and other repositories"
  }
  gdin: "godocs-inbox ⚠️" {
    link: https://h3-godocs-inbox.statichost.page/
    tooltip: "Local LLM classifier for godocs inbox"
  }
  gdw: "godocs-watcher ⚠️" {
    link: https://h3-godocs-watcher.statichost.page/
    tooltip: "Directory watcher for automatic imports"
  }
}

webui: "Web & UI" {
  style.fill: "#f3e8ff"
  style.stroke: "#a855f7"
  grid-columns: 2

  lg: "lofigui ⚠️" {
    link: https://h3-lofigui.statichost.page/
    tooltip: "HTML/CSS-first simple web front ends"
  }
  bb: bytestoneblog {
    link: https://h3-bytestoneblog.statichost.page/
    tooltip: "Blog on Kubernetes"
  }
  u2s: "url2svg ⚠️" {
    link: https://h3-url2svg.statichost.page/
    tooltip: "URL to SVG representation"
  }
  hgl: "hugo-golunr ⚠️" {
    link: https://h3-hugo-golunr.statichost.page/
    tooltip: "Hugo lunr alternative in Go"
  }
  mgr: "mermaid-go-renderer ⚠️" {
    link: https://h3-mermaid-go-renderer.statichost.page/
    tooltip: "Fast native Go Mermaid diagram renderer"
  }
}

hardware: "Hardware & Media" {
  style.fill: "#fce7f3"
  style.stroke: "#ec4899"
  grid-columns: 2

  gp: "gophoto ⚠️" {
    link: https://h3-gophoto.statichost.page/
    tooltip: "GoKrazy picture frame"
  }
  gth: "go-thumbnails ⚠️" {
